#
# Use this file to configure the dimensions of the shape display.
# All dimensions are in millimeters (mm).
#


# The width of one pixel, this includes both the moving part (pixel slider) and the stationary part (pixel holder).
PIXEL_WIDTH=5

# The height of one pixel. 
# TODO: This is RELATED the distance the pixel slider can move up or down.
PIXEL_HEIGHT=50

# The number of pixels per row.
PIXELS_PER_ROW=4

# The number of pixels per column.
PIXELS_PER_COLUMN=4

# Set the width of the pixel holder wall.
# The pixel holder refers to the part of the pixel that stays in place, and holds the pixel slider.
# Increase this if the shape display is too weak. Decrease this if you want to reduce the gaps between the pixels.
PIXEL_HOLDER_WALL_THICKNESS=0.5
